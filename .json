      "id": "n-02",
      "name": "1. Extract + CONFIG",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-340, 20]
    },
    {
      "parameters": {
        "content": "### 🧠 منطق التصنيف\n• CRITICAL: اسم الـ Workflow فيه clinic / chatbot / production (أنظمة عملاء حية)\n• WARNING: أنظمة داخلية وتجارب\n• is_retryable: Timeout / 429 / 5xx = أخطاء مؤقتة → آمنة للـ Retry التلقائي",
        "height": 180,
        "width": 320,
        "color": 3
      },
      "id": "sticky-03",
      "name": "Sticky — منطق التصنيف",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-100, -220]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// ===== 🧠 التصنيف + بناء رسالة التنبيه =====\n// كل فشل بيتصنف: CRITICAL (أنظمة عملاء) أو WARNING (داخلي) + بنتحدد لو آمن للـ Retry\nconst item = $input.first().json;\n\n// 1) التصنيف حسب اسم الـ Workflow (أنظمة العملاء الحية = CRITICAL)\nconst CRITICAL_KEYWORDS = ['clinic', 'whatsapp', 'receptionist', 'chatbot', 'rag', 'ecommerce', 'lead', 'client', 'production'];\nconst wfName = String(item.workflow_name || '').toLowerCase();\nconst isCritical = CRITICAL_KEYWORDS.some(k => wfName.includes(k));\n\n// 2) أخطاء مؤقتة معروفة = آمنة للإعادة التلقائية\nconst RETRYABLE_KEYWORDS = ['timeout', 'timed out', 'econnreset', 'econnrefused', 'enotfound', 'socket hang up', 'rate limit', '429', '502', '503', '504'];\nconst errMsg = String(item.error_message || '').toLowerCase();\nconst isRetryable = RETRYABLE_KEYWORDS.some(k => errMsg.includes(k));\n\n// 3) رسالة التنبيه النهائية (هتتبعت لـ Telegram)\nconst icon = isCritical ? '🚨' : '⚠️';\nconst alert_message = [\n  icon + ' ' + (isCritical ? 'CRITICAL — Client System' : 'WARNING — Internal'),\n  '',\n  '👤 System: ' + item.system_owner,\n  '🔀 Workflow: ' + item.workflow_name + ' (ID: ' + item.workflow_id + ')',\n  '🔌 Failed Node: ' + item.failed_node,\n  '💬 Error: ' + item.error_message,\n  '🕐 Time: ' + item.timestamp + ' (Cairo)',\n  '🔁 Auto-Retry Safe: ' + (isRetryable ? 'YES — auto-retry is OK' : 'NO — needs human'),\n  '',\n  '🔍 Inspect: ' + (item.execution_url ? item.execution_url : 'n8n > Executions > ID ' + item.execution_id)\n].join('\\n');\n\nreturn [{ json: { ...item, severity: isCritical ? 'CRITICAL' : 'WARNING', is_critical: isCritical, is_retryable: isRetryable, alert_message } }];"
      },
      "id": "n-03",
      "name": "2. Classify & Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-80, 20]
    },
