            "Severity": "={{ $('2. Classify & Format').first().json.severity }}",
            "System": "={{ $('2. Classify & Format').first().json.system_owner }}",
            "Workflow": "={{ $('2. Classify & Format').first().json.workflow_name }}",
            "Failed Node": "={{ $('2. Classify & Format').first().json.failed_node }}",
            "Error Message": "={{ $('2. Classify & Format').first().json.error_message }}",
            "Retryable": "={{ $('2. Classify & Format').first().json.is_retryable }}",
            "Execution URL": "={{ $('2. Classify & Format').first().json.execution_url }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "n-05",
      "name": "4. Google Sheets Log",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [440, 20]
