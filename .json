        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "n-04",
      "name": "3. Telegram Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [180, 20]
    },
